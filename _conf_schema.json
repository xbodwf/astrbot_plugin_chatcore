{
  "chat": {
    "description": "聊天主设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "插件总开关",
        "type": "bool",
        "default": true
      },
      "takeover": {
        "description": "接管模式",
        "type": "bool",
        "default": true,
        "hint": "接管 AstrBot 原生 LLM 链路（建议开启）。开启后 ChatCore 处理的消息将阻止 AstrBot 原生继续处理"
      },
      "private_force_reply": {
        "description": "私聊必回",
        "type": "bool",
        "default": true,
        "hint": "私聊消息必定回复，不参与概率"
      },
      "group_enabled": {
        "description": "群聊启用",
        "type": "bool",
        "default": true,
        "hint": "关闭后群消息只记录不回复"
      },
      "markers_enabled": {
        "description": "主动动作",
        "type": "bool",
        "default": true,
        "hint": "允许 AI 用 [[at:昵称]] / [[reply:昵称]] 主动 @ 或回复群成员"
      },
      "reminder": {
        "description": "模型提醒",
        "type": "text",
        "default": "",
        "hint": "每次调用模型前附加给模型的提醒/环境信息（追加到系统提示末尾），可留空。第三方 on_llm_request 插件（如 LLMPerception）注入的环境信息也会照常生效"
      },
      "tools_enabled": {
        "description": "工具调用",
        "type": "bool",
        "default": true,
        "hint": "开启后把 AstrBot 注册的工具（含定时任务/主动消息等内置工具）下发给模型，AI 可以调用工具并主动发起定时提醒"
      },
      "max_tool_rounds": {
        "description": "单次回复最大工具轮数",
        "type": "int",
        "default": 3,
        "hint": "防止工具调用死循环，达到轮数后强制输出文本回复"
      },
      "llm_blacklist": {
        "description": "LLM 黑名单",
        "type": "list",
        "item_type": "text",
        "default": [],
        "hint": "填会话 UMO（如 Sylvia:GroupMessage:384128966 或 平台:私聊类型:QQ号）后，这些会话完全禁用 LLM：消息照常记录但不回复。可在 AstrBot 日志 ChatCore recv 行看到 conv_id（即 UMO）"
      }
    }
  },
  "attention": {
    "description": "注意力机制",
    "type": "object",
    "items": {
      "bubble_base_prob": {
        "description": "冒泡基线概率",
        "type": "float",
        "default": 0.02,
        "hint": "群聊无人搭理时 AI 自发插话的概率（建议 0.01~0.03）"
      },
      "active_max_prob": {
        "description": "活跃态封顶概率",
        "type": "float",
        "default": 0.3,
        "hint": "有人与 AI 对话时概率上限"
      },
      "decay_minutes": {
        "description": "衰减时间(分钟)",
        "type": "float",
        "default": 10.0,
        "hint": "超过该时长无人维持，概率指数降回基线"
      },
      "hard_trigger_force": {
        "description": "硬触发必回",
        "type": "bool",
        "default": true,
        "hint": "被 @/reply/唤醒前缀 时是否必定回复"
      },
      "hard_trigger_boost": {
        "description": "硬触发活跃度加成",
        "type": "float",
        "default": 0.1,
        "hint": "每次被 @/reply 额外提升的概率"
      },
      "wake_prefix": {
        "description": "唤醒前缀列表",
        "type": "list",
        "default": [
          "bot",
          "ai",
          "机器人"
        ],
        "hint": "不带 @ 直接喊也能触发"
      },
      "cool_down_seconds": {
        "description": "回复冷却(秒)",
        "type": "int",
        "default": 120,
        "hint": "AI 刚回复过，该时长内抑制软触发（被 @ 等硬触发仍必回）"
      },
      "no_action_backoff": {
        "description": "落空退避系数",
        "type": "float",
        "default": 0.6,
        "hint": "连续软触发落空（没轮到说话）时，每落空一次把概率乘以该系数"
      },
      "backoff_floor": {
        "description": "退避下限",
        "type": "float",
        "default": 0.25,
        "hint": "退避最多把概率压到多少倍（0~1），避免完全闭嘴"
      },
      "time_rules": {
        "description": "时段发言频率规则",
        "type": "list",
        "item_type": "object",
        "default": [],
        "hint": "按时间段调整发言概率，如凌晨压低、晚间抬高。每项: {\"start\": \"00:00\", \"end\": \"06:00\", \"multiplier\": 0.2}；start>end 视为跨夜"
      },
      "read_air_factor": {
        "description": "读空气压低系数",
        "type": "float",
        "default": 0.5,
        "hint": "他人高密度对话（未 @bot）时，把冒泡概率乘以该系数"
      },
      "others_density_threshold": {
        "description": "高密度对话判定条数",
        "type": "int",
        "default": 3,
        "hint": "3 分钟内他人发言达到该条数即视为在激烈讨论"
      },
      "followup_boost": {
        "description": "话题延续加成",
        "type": "float",
        "default": 0.05,
        "hint": "bot 上次发言后话题仍在延续时，给概率的额外提升"
      }
    }
  },
  "segment": {
    "description": "智能分段",
    "type": "object",
    "items": {
      "delimiter": {
        "description": "AI 自我分段符",
        "type": "text",
        "default": "\n---\n",
        "hint": "AI 输出该分隔符即切段。建议填一个独占一行的小标记（如 ---）。若要用换行包围标记，请直接按回车输入真实换行符；真实换行符不含反斜杠，不要写成 \\n（反斜杠加字母 n）"
      },
      "escape_char": {
        "description": "转义符",
        "type": "string",
        "default": "\\",
        "hint": "AI 想输出分段符本身时在其前加该字符"
      },
      "interval": {
        "description": "分段发送间隔(秒)",
        "type": "float",
        "default": 1.0,
        "hint": "每段之间等待的时长"
      },
      "max_segment_chars": {
        "description": "单段最大字符数",
        "type": "int",
        "default": 300,
        "hint": "AI 忘了分段时的兜底保护，0 为不限制。群聊建议 200~300，越小分段越勤"
      }
    }
  },
  "context": {
    "description": "智能上下文",
    "type": "object",
    "items": {
      "recent_count": {
        "description": "近 N 条完整原文",
        "type": "int",
        "default": 10,
        "hint": "直接喂给 AI 的完整原文条数"
      },
      "history_count": {
        "description": "历史压缩条数",
        "type": "int",
        "default": 30,
        "hint": "recent 之外的更早消息保留条数"
      },
      "llm_summarize": {
        "description": "LLM 压缩历史",
        "type": "bool",
        "default": true,
        "hint": "开启后更早历史由聊天模型异步生成摘要；关闭则逐条截断"
      },
      "quote_max_depth": {
        "description": "引用消息回溯深度",
        "type": "int",
        "default": 15,
        "hint": "用户引用消息时，向 AI 提供被引用内容，支持连锁引用；此值为最大回溯层数"
      },
      "old_msg_chars": {
        "description": "每条历史消息压缩后的最大字符数",
        "type": "int",
        "default": 40,
        "hint": "仅未开启 LLM 压缩时的兜底逐条截断长度"
      }
    }
  },
  "history": {
    "description": "持久化聊天记录",
    "type": "object",
    "items": {
      "inject_enabled": {
        "description": "自动注入历史记录",
        "type": "bool",
        "default": true,
        "hint": "构建上下文时注入 AstrBot 持久化的当前会话历史；群聊额外注入同发送者私聊"
      },
      "max_messages": {
        "description": "注入的最大消息条数",
        "type": "int",
        "default": 10,
        "hint": "取最近 N 条历史记录"
      },
      "max_chars": {
        "description": "注入的总字符上限",
        "type": "int",
        "default": 1200,
        "hint": "超出后仅保留尾部"
      }
    }
  },
  "providers": {
    "description": "模型提供商",
    "type": "object",
    "items": {
      "chat": {
        "description": "聊天主模型",
        "type": "object",
        "items": {
          "provider_id": {
            "description": "聊天模型提供商",
            "type": "string",
            "default": "",
            "_special": "select_provider",
            "hint": "在 AstrBot「模型提供商」页面配置后选择"
          },
          "multimodal": {
            "description": "多模态识图",
            "type": "bool",
            "default": false,
            "hint": "聊天模型是否原生支持识图。开启后图片直接传给聊天模型，无需单独配置识图模型"
          }
        }
      },
      "vision": {
        "description": "识图模型",
        "type": "object",
        "items": {
          "provider_id": {
            "description": "识图模型提供商",
            "type": "string",
            "default": "",
            "_special": "select_provider",
            "hint": "需支持视觉输入。消息含图片时转文字描述；留空时复用聊天模型"
          }
        }
      },
      "summary": {
        "description": "上下文压缩模型",
        "type": "object",
        "items": {
          "provider_id": {
            "description": "压缩/摘要模型提供商",
            "type": "string",
            "default": "",
            "_special": "select_provider",
            "hint": "用于把更早历史压缩成摘要；留空时复用聊天模型"
          }
        }
      },
      "embedding": {
        "description": "嵌入模型",
        "type": "object",
        "items": {
          "provider_id": {
            "description": "Embedding 提供商 ID",
            "type": "string",
            "default": "",
            "hint": "用于全局记忆向量检索。在 AstrBot「模型提供商」页面配置 Embedding 提供商后，将其 ID 填入此处"
          }
        }
      }
    }
  },
  "memory": {
    "description": "全局记忆与自我学习",
    "type": "object",
    "items": {
      "enabled": {
        "description": "记忆开关",
        "type": "bool",
        "default": true
      },
      "shared_across_groups": {
        "description": "跨群数据互通",
        "type": "bool",
        "default": false,
        "hint": "开启后各群/私聊的记忆互相共享；关闭则记忆按会话隔离，某群/私聊的记忆不会泄漏给其他群/私聊"
      },
      "max_recall": {
        "description": "每次请求最多召回的记忆片段数",
        "type": "int",
        "default": 5
      }
    }
  },
  "implicit": {
    "description": "隐性意图分析",
    "type": "object",
    "items": {
      "enabled": {
        "description": "隐性分析开关",
        "type": "bool",
        "default": true
      },
      "interval_minutes": {
        "description": "分析最小间隔(分钟)",
        "type": "int",
        "default": 30,
        "hint": "避免频繁调用"
      },
      "prob_boost": {
        "description": "命中隐性相关话题后的概率提升",
        "type": "float",
        "default": 0.05
      },
      "provider_id": {
        "description": "隐性分析模型提供商",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "与聊天模型相互独立；留空则关闭隐性分析"
      },
      "prompt": {
        "description": "分析提示词",
        "type": "text",
        "default": "你是聊天活跃度分析器。判断群聊最近记录中是否有人隐性提及机器人、在邀请机器人参与话题、或有机器人值得参与的话题。只回答“是”或“否”。",
        "editor_mode": true,
        "hint": "留空使用默认提示词"
      }
    }
  },
  "recall_cancel": {
    "description": "撤回取消",
    "type": "object",
    "items": {
      "enabled": {
        "description": "撤回取消开关",
        "type": "bool",
        "default": true,
        "hint": "用户撤回触发消息后，停止 AI 回复"
      }
    }
  },
  "profile": {
    "description": "人物画像",
    "type": "object",
    "items": {
      "enabled": {
        "description": "人物画像开关",
        "type": "bool",
        "default": true,
        "hint": "为每个用户维护结构化画像（稳定事实/偏好/互动特点），回复后自动提取写回，构建请求时注入"
      },
      "max_chars": {
        "description": "单条画像注入上限(字符)",
        "type": "int",
        "default": 600,
        "hint": "压缩后注入上下文的画像文本最大字符数"
      }
    }
  },
  "expression": {
    "description": "表达风格学习",
    "type": "object",
    "items": {
      "enabled": {
        "description": "表达学习开关",
        "type": "bool",
        "default": true,
        "hint": "定期从群聊学习句式/语气/黑话，注入系统提示让 AI 说话更像群友"
      },
      "interval_minutes": {
        "description": "学习采样间隔(分钟)",
        "type": "int",
        "default": 60,
        "hint": "多久采样一次群聊记录进行风格学习，最小 30 分钟"
      },
      "max_chars": {
        "description": "风格注入上限(字符)",
        "type": "int",
        "default": 800,
        "hint": "注入系统提示的表达风格文本最大字符数"
      },
      "shared_groups": {
        "description": "表达互通群列表",
        "type": "list",
        "item_type": "text",
        "default": [],
        "hint": "这些群的表达风格会互相借鉴（只有风格受影响，记忆不受影响）。填 unified_msg_origin"
      }
    }
  },
  "emoji": {
    "description": "表情包系统",
    "type": "object",
    "items": {
      "enabled": {
        "description": "表情包开关",
        "type": "bool",
        "default": true,
        "hint": "收集群内图片建立带溯源的表情包库，AI 回复可用 [[emoji:意图或编号]] 发送"
      },
      "max_entries": {
        "description": "表情包库存上限",
        "type": "int",
        "default": 500,
        "hint": "超过上限后淘汰最久未使用的表情包"
      },
      "vision_provider_id": {
        "description": "分类视觉模型",
        "type": "text",
        "default": "",
        "hint": "用于描述并分类表情包的视觉模型 provider id；留空则复用对话模型"
      }
    }
  },
  "emotion": {
    "description": "情绪/状态系统",
    "type": "object",
    "items": {
      "enabled": {
        "description": "情绪系统开关",
        "type": "bool",
        "default": true,
        "hint": "每会话维护情绪状态，回复后按氛围概率切换，注入系统提示影响措辞语气"
      },
      "trait": {
        "description": "情绪特质",
        "type": "string",
        "default": "neutral",
        "hint": "决定情绪基线：rational_calm（理性克制）/ neutral（中性）/ sentimental（感性细腻）",
        "choices": [
          "rational_calm",
          "neutral",
          "sentimental"
        ]
      },
      "states": {
        "description": "可切换状态列表",
        "type": "list",
        "item_type": "object",
        "default": [
          {
            "key": "兴奋",
            "description": "热情、话变多、可以多用感叹号",
            "switch_prob": 0.2
          },
          {
            "key": "慵懒",
            "description": "话少、简短、慢悠悠",
            "switch_prob": 0.2
          },
          {
            "key": "严肃",
            "description": "认真、正经、尽量客观严谨",
            "switch_prob": 0.15
          },
          {
            "key": "调侃",
            "description": "带点玩笑、损友风格，但不过分",
            "switch_prob": 0.15
          }
        ],
        "hint": "每项含 key / description / switch_prob（被选中概率）"
      },
      "switch_probability": {
        "description": "状态切换概率",
        "type": "float",
        "default": 0.5,
        "hint": "氛围变化（回复后）时实际切换情绪的概率（0~1）"
      },
      "decay_seconds": {
        "description": "情绪回落时间(秒)",
        "type": "int",
        "default": 1800,
        "hint": "该时长无互动后情绪回到基线，避免一直停留在一个状态"
      }
    }
  },
  "affinity": {
    "description": "好感度系统",
    "type": "object",
    "items": {
      "enabled": {
        "description": "好感度开关",
        "type": "bool",
        "default": true,
        "hint": "每会话维护好感度（0~100），互动增加、久不互动衰减，按亲疏程度影响回复语气与称呼"
      },
      "initial": {
        "description": "初始好感度",
        "type": "float",
        "default": 50,
        "hint": "新会话的好感度起点（0~100）"
      },
      "decay_per_day": {
        "description": "每日衰减值",
        "type": "float",
        "default": 2,
        "hint": "无互动时每天衰减的好感度"
      }
    }
  }
}